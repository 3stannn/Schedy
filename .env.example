# Schedy - Universal Developer Broadcast Configuration
# Copy this file to .env and configure your secret credentials locally or in your hosting provider (Vercel, Netlify, Cloudflare, etc.)

# Supabase Project URL (Developer Announcement Broadcast Database)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Developer Password for Publishing Universal Dev Announcements
VITE_DEV_PASSWORD=your_secret_dev_password_here



