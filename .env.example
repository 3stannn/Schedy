# Schedy - Environment Variables Example
# Duplicate this file as .env and fill in your Supabase project credentials

# Supabase Cloud Database & Universal Realtime Sync
VITE_UNIVERSAL_SUPABASE_URL=https://your-project.supabase.co
VITE_UNIVERSAL_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Fallback Supabase Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Developer Password for Universal Announcements
VITE_DEV_PASSWORD=your-developer-password-here

# Dedicated Supabase Project for Authentication & Paid Features (User Accounts & Profiles)
VITE_AUTH_SUPABASE_URL=https://your-auth-project.supabase.co
VITE_AUTH_SUPABASE_ANON_KEY=your-auth-supabase-anon-key-here

# Polar.sh Paywall Configuration (Checkout Link for Pro Tier)
VITE_POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_example_checkout_id

# Google Gemini API Key (for AI Schedule Text Extraction)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

